{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yanyu-speed",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "yanyubaby.eu.org", "custom_domain": true }
  ]
}
